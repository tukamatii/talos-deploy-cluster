# Файл: controlplane.yaml.j2
# Это Jinja2 шаблон для генерации конфигурации control plane.
version: v1alpha1
debug: false
persist: true
machine:
  type: controlplane
  token: "{{ talos_secrets.trustdinfo.token }}"
  ca:
    crt: |
      {{ talos_secrets.certs.os.crt | indent(6) }}
    key: |
      {{ talos_secrets.certs.os.key | indent(6) }}
  certSANs: []
  kubelet:
    image: ghcr.io/siderolabs/kubelet:v1.34.1
    defaultRuntimeSeccompProfileEnabled: true
    disableManifestsDirectory: true
  network:
{{ talos_machine_network | to_nice_yaml(indent=2) }}
{{ talos_machine_additional_config | to_nice_yaml(indent=2) }}

  install:
    disk: /dev/sda
    image: ghcr.io/siderolabs/installer:v1.11.2
    wipe: false
  features:
    rbac: true
    stableHostname: true
    apidCheckExtKeyUsage: true
    diskQuotaSupport: true
    kubePrism:
      enabled: true
      port: 7445
    hostDNS:
      enabled: true
      forwardKubeDNSToHost: true
  nodeLabels:
    node.kubernetes.io/exclude-from-external-load-balancers: ""
cluster:
  id: "{{ talos_secrets.cluster.id }}"
  secret: "{{ talos_secrets.cluster.secret }}"
  controlPlane:
    endpoint: "{{ talos_controlplane_endpoint }}"
  clusterName: "{{ talos_cluster_name }}"
  network:
{{ talos_cluster_network | to_nice_yaml(indent=4) }}
  proxy:
    disabled: true
  token: "{{ talos_secrets.secrets.bootstraptoken }}"
  secretboxEncryptionSecret: "{{ talos_secrets.secrets.secretboxencryptionsecret }}"
  ca:
    crt: |
      {{ talos_secrets.certs.k8s.crt | indent(6) }}
    key: |
      {{ talos_secrets.certs.k8s.key | indent(6) }}
  aggregatorCA:
    crt: |
      {{ talos_secrets.certs.k8saggregator.crt | indent(6) }}
    key: |
      {{ talos_secrets.certs.k8saggregator.key | indent(6) }}
  serviceAccount:
    key: |
      {{ talos_secrets.certs.k8sserviceaccount.key | indent(6) }}
  apiServer:
    image: registry.k8s.io/kube-apiserver:v1.34.1
    certSANs:
      - "{{ talos_controlplane_endpoint | urlsplit('hostname') }}"
    disablePodSecurityPolicy: true
    admissionControl:
      - name: PodSecurity
        configuration:
          apiVersion: pod-security.admission.config.k8s.io/v1alpha1
          defaults:
            audit: restricted
            audit-version: latest
            enforce: baseline
            enforce-version: latest
            warn: restricted
            warn-version: latest
          exemptions:
            namespaces:
              - kube-system
            runtimeClasses: []
            usernames: []
          kind: PodSecurityConfiguration
    auditPolicy:
      apiVersion: audit.k8s.io/v1
      kind: Policy
      rules:
        - level: Metadata
  controllerManager:
    image: registry.k8s.io/kube-controller-manager:v1.34.1
  scheduler:
    image: registry.k8s.io/kube-scheduler:v1.34.1
  discovery:
    enabled: true
    registries:
      kubernetes:
        disabled: true
      service: {}
  etcd:
    ca:
      crt: |
        {{ talos_secrets.certs.etcd.crt | indent(6) }}
      key: |
        {{ talos_secrets.certs.etcd.key | indent(6) }}
{{ talos_cluster_additional_config | to_nice_yaml(indent=2) }}
