diff --git a/tasks/init_talos.yml b/tasks/init_talos.yml
index b59d5c7..79400a1 100644
--- a/tasks/init_talos.yml
+++ b/tasks/init_talos.yml
@@ -3,7 +3,7 @@
   ansible.builtin.shell:
     cmd:
       "talosctl patch machineconfig -n {{s1_ip_addr.split('/')[0] }} --patch @{{ role_path }}/files/trustedcerts.yaml \
-      --talosconfig {{talos_config_folder}}{{ target }}.yaml "
+      --talosconfig {{talos_config_file}}"
   register: result
   until: result.rc == 0
   retries: 3
@@ -15,7 +15,7 @@
   ansible.builtin.shell:
     cmd:
       "talosctl get etcdMembers -n {{ hostvars[groups[target][0]].s1_ip_addr.split('/')[0] }} -o json \
-      --talosconfig {{talos_config_folder}}{{ target }}.yaml "
+      --talosconfig {{talos_config_file}}"
   register: etcd_check
   changed_when: false
   delegate_to: localhost
@@ -25,7 +25,7 @@
   ansible.builtin.shell:
     cmd:
       "talosctl bootstrap -n {{ hostvars[groups[target][0]].s1_ip_addr.split('/')[0] }} \
-      --talosconfig {{talos_config_folder}}{{ target }}.yaml "
+      --talosconfig {{talos_config_file}}"
   when:
     - etcd_check.rc == 0
     - etcd_check.stdout | trim == ""
@@ -35,18 +35,36 @@
 
 - name: Delete old kubeconfig
   ansible.builtin.file:
-    path: "{{kube_config_folder}}{{ target }}.yaml"
+    path: "{{item}}"
     state: absent
   delegate_to: localhost
   run_once: true
+  loop:
+    - "{{kube_config_file}}"
+    - "{{kube_config_file_no_loadbalancer}}"
 
 - name: Download Kubeconfig
   ansible.builtin.shell:
     cmd:
       "talosctl kubeconfig -n {{ hostvars[groups[target][0]].s1_ip_addr.split('/')[0] }} \
-      --talosconfig {{talos_config_folder}}{{ target }}.yaml {{kube_config_folder}}{{ target }}.yaml -f"
+      --talosconfig {{talos_config_file}} {{item}}"
   delegate_to: localhost
   run_once: true
+  loop:
+    - "{{kube_config_file}}"
+    - "{{kube_config_file_no_loadbalancer}}"
+
+- name: Replace server IP in kubeconfig with first controlplane node
+  ansible.builtin.replace:
+    path: "{{ kube_config_file_no_loadbalancer }}"
+    regexp: "server: https://[0-9.]+:6443"
+    replace: "server: https://{{ first_controlplane_ip }}:6443"
+  delegate_to: localhost
+  run_once: true
+  vars:
+    controlplane_hosts: "{{ groups[target] | map('extract', hostvars) | selectattr('talos_node_type', '==', 'controlplane') | list }}"
+    first_controlplane_ip: "{{ (controlplane_hosts | first).s1_ip_addr.split('/')[0] }}"
+  when: controlplane_hosts | length > 0
 
 - name: Wait 5 more minutes
   ansible.builtin.pause:
